// Appendix A walkthrough: three boolean atoms p, q and r
diagram Walkthrough

attributes {
  p : boolean;
  q : boolean;
  r : boolean;
}

initial state s0 { p = TRUE, q = TRUE, r = FALSE } at (100, 200)
state s1 { p = FALSE, q = TRUE, r = TRUE } at (320, 90)
state s2 { p = FALSE, q = FALSE, r = TRUE } at (320, 310)

s0 -> s1;
s0 -> s2;
s1 -> s2;
s2 -> s0;

LTLSPEC G (p -> F r);
CTLSPEC AG (q -> EX r);
